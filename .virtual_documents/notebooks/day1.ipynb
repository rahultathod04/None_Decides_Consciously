
# DAY1 : Data Loading & First Look
# GOAL : Understand the shape and structure of our dataset
import pandas as pd
import numpy as np 
import matplotlib.pyplot as plt


df = pd.read_csv("../data/raw/student_lifestyle.csv")


df.head()


print("Dataset loaded successfully!")
print(f" rows: {df.shape[0]} ")
print(f"columns: {df.shape[1]}")


print("column info")
print(df.info())


print(" Missing Values:")
missing = df.isnull().sum()
print(missing[missing > 0] if missing.sum() > 0 else " No missing values found!")


print("Basic Statistics:")
df.describe()


# Missing Value Summary

print("MISSING VALUE REPORT")

missing = df.isnull().sum()
missing_prct = (df.isnull().sum() / len(df)) * 100

missing_report = pd.DataFrame({
    'Missing Count': missing,
    'Missing %': missing_prct.round(2)
})

print(missing_report[missing_report['Missing Count'] > 0])
print("=" * 45)
print(f"Total missing cells: {df.isnull().sum().sum()}")


for col in df.columns:
    print(f"\n {col}")
    print("="*20)
    print(f" type : {df[col].dtype}")
    print(f" null values : {df[col].isnull().sum()}")
    print(f" sample : {df[col].dropna().unique()[:5]}")
    print(f" sample_max : {df[col].dropna().unique().max()}")
    print(f" sample_min : {df[col].dropna().unique().min()}")









